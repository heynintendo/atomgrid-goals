# =============================================================================
# Atomberg Goal Setting & Tracking Portal — environment template
# Copy this to `.env` for local dev, set the real values in Vercel for prod.
# =============================================================================

# -----------------------------------------------------------------------------
# Neon Postgres — https://console.neon.tech
# -----------------------------------------------------------------------------
# DATABASE_URL  : pooled connection used by the app at runtime (PgBouncer).
# DATABASE_URL_UNPOOLED : direct connection used by Prisma migrations only.
# Both come from the same Neon project; copy them from
#   Project → Connection details → "Connection string"
# Toggle "Pooled connection" to copy the pooled vs. direct form.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# -----------------------------------------------------------------------------
# Auth.js v5 — https://authjs.dev
# -----------------------------------------------------------------------------
# AUTH_SECRET : generate with `openssl rand -base64 32` or `pnpm exec auth secret`
# AUTH_URL    : public base URL of the deployed app, no trailing slash.
#               Local: http://localhost:3000.  Prod: your Vercel URL.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# App base URL — absolute links in emails & OG metadata (src/lib/app-url.ts)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL : public base URL of the deployed app, no trailing slash.
#   Set the real value in Vercel after the project rename.  Local dev may
#   leave it blank — app-url.ts falls back to VERCEL_URL, then localhost.
NEXT_PUBLIC_APP_URL=https://atomberg-goals.vercel.app

# -----------------------------------------------------------------------------
# Microsoft Entra ID — https://entra.microsoft.com → App registrations → New
# -----------------------------------------------------------------------------
# Configure the app registration with:
#   - Redirect URI (Web): {AUTH_URL}/api/auth/callback/microsoft-entra-id
#   - API permissions:    Microsoft Graph → User.Read (delegated)
#   - Optional: token configuration → add "groups" claim for role mapping
#
# AUTH_MICROSOFT_ENTRA_ID_ID      : "Application (client) ID" from the Overview page
# AUTH_MICROSOFT_ENTRA_ID_SECRET  : Certificates & secrets → New client secret → copy the Value (not the ID)
# AUTH_MICROSOFT_ENTRA_ID_ISSUER  : "https://login.microsoftonline.com/<tenant-id>/v2.0"
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# -----------------------------------------------------------------------------
# Resend — https://resend.com/api-keys
# -----------------------------------------------------------------------------
# RESEND_API_KEY    : Dashboard → API keys → Create. Starts with "re_".
# RESEND_FROM_EMAIL : Verified sender domain or "onboarding@resend.dev" for hackathon.
# RESEND_TO_EMAIL   : hackathon recipient — ALL transactional mail is routed here so
#   judges' inboxes stay clean. Unset = emails are skipped (logged, never sent).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=

# -----------------------------------------------------------------------------
# Vercel Cron — protects /api/cron/* from public invocation
# -----------------------------------------------------------------------------
# Set in Vercel Project → Settings → Environment Variables.
# Generate with `openssl rand -hex 32`.
# Vercel Cron requests automatically include Authorization: Bearer ${CRON_SECRET}.
CRON_SECRET=
